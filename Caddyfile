# SITE_ADDRESS из .env:
#   ":80"              — сайт по http://IP
#   "shop.example.com" — Caddy сам выпустит HTTPS-сертификат (Let's Encrypt)
{$SITE_ADDRESS}

encode zstd gzip

handle_path /static/* {
	root * /srv/static
	header Cache-Control "public, max-age=31536000"
	file_server
}

handle_path /media/* {
	root * /srv/media
	file_server
}

handle {
	request_body {
		max_size 20MB
	}
	reverse_proxy web:8000
}
