# Скопируйте в .env на сервере и заполните.  cp .env.production.example .env

# --- Django ---
DEBUG=False
SECRET_KEY=сгенерируйте-длинную-случайную-строку
# IP сервера (и домен, когда появится), через запятую
ALLOWED_HOSTS=203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10
# Куда Stripe возвращает после оплаты и куда ведёт ссылка сброса пароля
FRONTEND_URL=http://203.0.113.10
# Адрес для Caddy: ":80" для IP; потом домен, например shop.example.com
SITE_ADDRESS=:80

# --- PostgreSQL (контейнер создаст базу сам) ---
DB_NAME=sport_shop
DB_USER=sport_shop
DB_PASSWORD=сложный-пароль-базы

# --- Почта ---
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=пароль-приложения-gmail
DEFAULT_FROM_EMAIL=you@gmail.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# секрет эндпоинта из Stripe Dashboard → Webhooks (не из stripe listen!)
STRIPE_WEBHOOK_SECRET=whsec_...
